# PLACEHOLDERS ONLY. Real values go in Cloudflare Worker secrets (wrangler secret put ...) or worker/.dev.vars (git-ignored).
# Never commit real keys. Never paste a provider key into the website Settings or into a chat.
ANTHROPIC_API_KEY=your-provider-api-key-here
APP_TOKEN=choose-a-long-random-access-code
ALLOWED_ORIGIN=https://mogrmnet.github.io
KNOWLEDGE_URL=https://mogrmnet.github.io/XBoot/knowledge.json
ANTHROPIC_MODEL=claude-sonnet-5-5
# Frontend (GitHub repository *variable*, not secret): GARHI_API_URL=https://garhi-api.<your-subdomain>.workers.dev
